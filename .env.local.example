# === Supabase ===
# Projet > Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service role (serveur uniquement, ne jamais exposer côté client)
SUPABASE_SERVICE_ROLE_KEY=

# === Resend (notification e-mail des demandes) — optionnel ===
RESEND_API_KEY=
# Adresse d'expédition vérifiée dans Resend
BOOKING_FROM_EMAIL=
# Adresse qui reçoit les demandes WVion
BOOKING_NOTIFY_EMAIL=
